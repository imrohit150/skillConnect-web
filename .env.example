NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Next.js rewrite target (server configuration, without /api/v1).
# On Vercel set this to the HTTPS Render backend origin before building.
# Production uses same-origin API/chat routes and ignores the two local URLs above.
BACKEND_ORIGIN=http://localhost:5000
